DATABASE_URL=postgres://user:password@host:5432/dbname

# External dispatch system DB we read from (read-only). One or more
# company/tenant rows in that DB, numbered from 1 (TARGET_DB_COMPANY_ID_1,
# TARGET_DB_COMPANY_ID_2, ...) — each synced independently.
TARGET_DB_URL=postgres://user:password@host:5432/dispatch
TARGET_DB_COMPANY_ID_1=

MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
# "Fuel Board 2.0" — items (trucks) are created/deleted by the other side, not by us.
MONDAY_SECONDARY_BOARD_ID=

SAMSARA_API_TOKEN=

GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
GOOGLE_SHEET_ID=
